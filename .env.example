# Optional but recommended: raises GitHub API rate limit from 60/hr to 5000/hr.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Used in phase 2 (draft generator) — not required for ingestion alone.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

PORT=3000
